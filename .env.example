# Porta da API
PORT=3333

# Conexão com o PostgreSQL (a mesma do docker-compose)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gerenciador_tarefas?schema=public"

# Segredo usado para assinar os tokens JWT (troque em produção!)
JWT_SECRET="troque-este-segredo"
JWT_EXPIRES_IN="1d"

# Usuário admin criado pelo seed (npm run db:seed)
ADMIN_NAME="Admin"
ADMIN_EMAIL="admin@email.com"
ADMIN_PASSWORD="admin123"
